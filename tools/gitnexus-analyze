#!/usr/bin/env python3
"""Run one machine-wide GitNexus analysis at a time with stable defaults."""

from __future__ import annotations

import argparse
import fcntl
import os
from pathlib import Path
import signal
import subprocess
import sys

GITNEXUS = "/opt/homebrew/bin/gitnexus"
SECRETS_FILE = Path.home() / ".config/mcp-gateway/secrets.env"
LOCK_FILE = Path.home() / ".gitnexus/analyze-global.lock"

DEFAULT_ENV = {
    "GITNEXUS_EMBEDDING_URL": "https://openrouter.ai/api/v1",
    "GITNEXUS_EMBEDDING_MODEL": "qwen/qwen3-embedding-8b",
    "GITNEXUS_EMBEDDING_DIMS": "4096",
    "GITNEXUS_EMBEDDING_REQUEST_DIMS": "omit",
    "GITNEXUS_EMBEDDING_BATCH_SIZE": "32",
    "GITNEXUS_EMBEDDING_SUB_BATCH_SIZE": "32",
    "GITNEXUS_EMBEDDING_MAX_ATTEMPTS": "5",
    "GITNEXUS_EMBEDDING_RETRY_CAP_MS": "30000",
    "GITNEXUS_EMBEDDING_MIN_INTERVAL_MS": "250",
    "GITNEXUS_WORKER_POOL_SIZE": "4",
    "GITNEXUS_PARSE_CHUNK_CONCURRENCY": "1",
    "GITNEXUS_INDEX_LOCK_TIMEOUT_MS": "1800000",
    "GITNEXUS_LBUG_BUFFER_POOL_SIZE": "1073741824",
    "GITNEXUS_FTS_STEMMER": "porter",
    "GITNEXUS_FTS_CJK_SEGMENTATION": "none",
    "GITNEXUS_COMMUNITY_ENGINE": "graphology",
    "GITNEXUS_STREAM_GRAPH_EMIT": "1",
    "GITNEXUS_LBUG_EXTENSION_INSTALL": "load-only",
}


def read_secret(name: str) -> str | None:
    try:
        lines = SECRETS_FILE.read_text(encoding="utf-8").splitlines()
    except FileNotFoundError:
        return None
    for raw_line in lines:
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        key, separator, value = line.partition("=")
        if separator and key.strip() == name:
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
                value = value[1:-1]
            return value
    return None


def terminate_group(process: subprocess.Popen[bytes], sig: signal.Signals) -> None:
    try:
        os.killpg(process.pid, sig)
    except ProcessLookupError:
        return


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("repo", nargs="?", default=".", help="repository path (default: cwd)")
    parser.add_argument("--name", help="stable global registry alias")
    parser.add_argument("--pdg", action="store_true", help="build PDG and taint layers")
    args = parser.parse_args()

    repo = str(Path(args.repo).expanduser().resolve())
    env = os.environ.copy()
    env.update(DEFAULT_ENV)
    api_key = env.get("OPENROUTER_API_KEY") or read_secret("OPENROUTER_API_KEY")
    if not api_key:
        parser.error(f"OPENROUTER_API_KEY is unavailable in the environment or {SECRETS_FILE}")
    env["GITNEXUS_EMBEDDING_API_KEY"] = api_key

    command = [
        GITNEXUS,
        "analyze",
        repo,
        "--embeddings",
        "0",
        "--index-only",
        "--workers",
        "4",
        "--max-file-size",
        "512",
        "--embedding-batch-size",
        "32",
        "--embedding-sub-batch-size",
        "32",
    ]
    if args.name:
        command.extend(["--name", args.name])
    if args.pdg:
        command.append("--pdg")

    LOCK_FILE.parent.mkdir(parents=True, exist_ok=True)
    with LOCK_FILE.open("a+b") as lock:
        print(f"Waiting for machine-wide GitNexus writer lock: {LOCK_FILE}", flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
        print(f"Analyzing {repo}", flush=True)
        process = subprocess.Popen(command, env=env, start_new_session=True)
        try:
            return process.wait()
        except KeyboardInterrupt:
            terminate_group(process, signal.SIGINT)
            try:
                return process.wait(timeout=30)
            except subprocess.TimeoutExpired:
                terminate_group(process, signal.SIGKILL)
                return process.wait()


if __name__ == "__main__":
    sys.exit(main())
