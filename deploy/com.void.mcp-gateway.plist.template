<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.void.mcp-gateway</string>

    <!-- TEMPLATE: install.sh substitutes @@HOME@@ with the installing user's
         home and writes the result to ~/Library/LaunchAgents. Never installed
         verbatim; never carries a specific user's paths in the repo. -->
    <!-- Runs the venv's mcp-gateway console script directly (no `uv run`
         supervisor) — one resident process. Recreate the venv with `uv sync`. -->
    <!-- Every repo path goes through the STABLE symlink
         ~/.local/opt/mcp-gateway (maintained by install.sh), never the real
         clone location (#149): launchd needs absolute paths, and hardcoding
         the clone's path meant a repo move silently orphaned the LaunchAgent
         while a ghost process kept /health green. After moving the repo,
         re-run ./install.sh — this file needs no edit. -->
    <key>ProgramArguments</key>
    <array>
        <string>@@HOME@@/.local/opt/mcp-gateway/.venv/bin/mcp-gateway</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@@HOME@@/.local/opt/mcp-gateway</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd gives a minimal PATH; include user + system bins so the
             gateway and its stdio backends (for example, local tooling) resolve. -->
        <key>PATH</key>
        <string>@@HOME@@/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Absolute config path so it resolves regardless of cwd. -->
        <key>MCP_GATEWAY_CONFIG</key>
        <string>@@HOME@@/.local/opt/mcp-gateway/config.toml</string>
        <!-- FastMCP's log level is quieted in-process (server._configure_logging),
             so no FASTMCP_LOG_LEVEL env is needed here (#83, one suffices). -->
        <!-- Add backend secrets here when a backend needs them, e.g.:
             <key>EXA_TOKEN</key><string>...</string>
             (referenced from config.toml as auth_value = "Bearer ${EXA_TOKEN}") -->
    </dict>

    <key>StandardOutPath</key>
    <string>@@HOME@@/.local/state/mcp-gateway/out.log</string>
    <key>StandardErrorPath</key>
    <string>@@HOME@@/.local/state/mcp-gateway/err.log</string>
</dict>
</plist>
